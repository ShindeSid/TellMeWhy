GEMINI_API_KEY=
GEMINI_SMALL_MODEL=gemini-2.5-flash
GEMINI_LARGE_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

DATABASE_URL=sqlite+aiosqlite:///./trust_graph.db
CHROMA_PERSIST_DIR=./chroma_data

CORS_ORIGINS=http://localhost:3000

# Set true to run the full pipeline (KAN, verification, trust, sandbox) with
# canned LLM responses and canned retrieval instead of live Gemini/ChromaDB.
# Also unlocks the 3 preset Demo Mode buttons in the UI. See docs/DEMO.md.
DEMO_MODE=false
